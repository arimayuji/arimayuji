# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# signing keys/certs — never committed even if dropped in the project
# locally for a manual build; CI decodes these from secrets into /tmp, they
# never live in the repo (added in an LGPD/security audit pass as a
# defense-in-depth backstop — nothing had actually leaked, this just closes
# the gap for next time)
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
serviceAccount*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Appwrite CLI's own local client config (`appwrite client --endpoint ...`)
# — just a projectId, no secret, but this repo deliberately never adopted
# tracking it (see README.md's note on `create-deployment` vs `push
# functions` for why an `appwrite.config.json` here wouldn't even have the
# function list `push` needs). Regenerate locally with `appwrite client`
# whenever the CLI is used against this project.
appwrite.config.json

# vercel
.vercel

# wrangler local dev
/.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

# voice bank A/B quality samples (scripts/generate-voice-bank.ts --experiment=)
# — throwaway comparison clips for a human to listen to before picking a
# voice_settings winner, never meant to reach the real 135/270-clip bank
/public/audio/experiment-*/

# Claude Code personal/machine-local settings (hooks a given session opted
# into, e.g. the Impeccable design-check hook) — .claude/settings.json
# would be the shared/team version; this one is deliberately per-machine.
.claude/settings.local.json
