<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Needed for the native Sign in with Apple flow (ASAuthorizationAppleIDProvider,
	  via @capacitor-community/apple-sign-in — see src/lib/auth.ts's
	  nativeAppleSignIn) that replaced the browser-redirect OAuth2 flow on
	  iOS. The App ID itself almost certainly already has "Sign in with
	  Apple" enabled at developer.apple.com from the original OAuth setup
	  (task #51) — Apple requires that capability on the Primary App ID
	  before a linked Services ID can even be created — but this entitlement
	  key is what actually asks the provisioning profile for it; if a signed
	  build ever rejects with a missing-entitlement code-signing error,
	  check that capability toggle first.
	-->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<!--
	  "development" here, not "production" — Xcode/App Store Connect
	  rewrites this to "production" automatically in a signed release
	  archive (the same auto-swap it's always done for this entitlement),
	  so this only ever matters for local/simulator builds. Still requires
	  the "Push Notifications" capability enabled on the App ID itself in
	  developer.apple.com before this does anything (same console step
	  HealthKit's own capability needed) — src/lib/pushNotifications.ts's
	  header has the full external-setup list.
	-->
	<key>aps-environment</key>
	<string>development</string>
	<!--
	  Shared with RunActivityWidget.entitlements — the only channel the main
	  app and the Live Activity widget extension (two separate processes)
	  have to talk to each other. Used only for relaying the Live Activity's
	  Pausar/Finalizar button taps back to this app (see
	  RunActivityIntents.swift and CapgoCapacitorBackgroundGeolocationPlugin's
	  Darwin notification observer) — the run's real state (distance, GPS
	  points, persistence) never leaves useRunTracker.ts.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.xanthus.app</string>
	</array>
</dict>
</plist>
