<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Xanthus</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  Declara de antemão que o app não implementa criptografia própria (só
	  HTTPS padrão via Appwrite/MapTiler/Cloudflare) — sem isso, cada build
	  novo fica parado em "Missing Compliance" no App Store Connect até
	  alguém responder manualmente a pergunta de Export Compliance na UI.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>O Xanthus usa sua localização para registrar a rota e o pace da sua corrida.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>O Xanthus continua registrando sua rota e seu pace mesmo com a tela bloqueada durante a corrida.</string>
	<!--
	  @capgo/capacitor-health (src/lib/health.ts) — both keys required by
	  HealthKit the moment the plugin is present, regardless of whether the
	  app ever actually calls it; without them a build with this plugin
	  linked just crashes on any Health API access instead of showing a
	  permission prompt. Read-only in practice (HEALTH_DATA_ENABLED is still
	  false and nothing writes anything back), but HealthKit doesn't have a
	  read-only-capable entitlement — Xcode also needs the 'HealthKit'
	  capability added to the App ID in the Apple Developer Portal before
	  any of this actually works, a manual step this repo can't do for you.
	-->
	<key>NSHealthShareUsageDescription</key>
	<string>O Xanthus lê frequência cardíaca, calorias, passos, FC em repouso, variabilidade de FC (HRV), VO2 máx e sono do seu relógio, pra completar os dados dessa corrida.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>O Xanthus não grava nada no Saúde — essa permissão é exigida pelo sistema mesmo assim.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<!--
	  Required for the lock-screen/Dynamic Island Live Activity
	  (RunActivityWidget) — without this, Activity.request() throws at
	  runtime even with the widget extension correctly embedded.
	-->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!--
	  Where the system browser hands a finished Google/Apple OAuth login
	  back to this app (see src/lib/auth.ts's startOAuthSignIn and
	  src/app/oauth-callback-listener.tsx) — Google and Apple both refuse
	  to complete that login inside an embedded WebView, so it has to run
	  in Safari and come back through this URL scheme instead. Capacitor's
	  stock AppDelegate already forwards any `application(_:open:options:)`
	  call for a scheme registered here into the `App` plugin's
	  `appUrlOpen` event, no extra native code needed on top of this
	  declaration. The literal project ID here (matching
	  NEXT_PUBLIC_APPWRITE_PROJECT_ID) is Appwrite's own documented
	  `appwrite-callback-{PROJECT_ID}` convention, not a value invented
	  for this app.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>appwrite-callback-6a7cd5df0036246ce258</string>
			</array>
		</dict>
		<!-- Invite links (src/app/convite/page.tsx tries this first, before
		     falling back to the web landing page) — handled in
		     src/app/oauth-callback-listener.tsx alongside the OAuth callback
		     above, same appUrlOpen listener. -->
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>xanthus</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
