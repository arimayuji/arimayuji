# Optional backend for the account-based features (place ratings, friends,
# coach relationships) — see src/lib/supabase.ts. Everything else in the
# app (recording a run, history, PRs) works with none of this set.
#
# Get these from your Supabase project: Project Settings -> API.
# NEXT_PUBLIC_ prefix is required — this is a static export, so these are
# baked into the client bundle at build time, not read on a server.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
