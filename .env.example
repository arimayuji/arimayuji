# Optional backend for the account-based features (place ratings, friends,
# coach relationships) — see src/lib/appwrite.ts. Everything else in the
# app (recording a run, history, PRs) works with none of this set.
#
# Get these from your Appwrite console: Project Settings -> Overview.
# NEXT_PUBLIC_ prefix is required — this is a static export, so these are
# baked into the client bundle at build time, not read on a server.

NEXT_PUBLIC_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id

# Server-only — used exclusively by scripts/appwrite-setup.ts to provision
# collections/attributes/permissions once. Never prefixed with NEXT_PUBLIC_,
# never committed, never read by the app itself. Create it in the Appwrite
# console under Project Settings -> API Keys, with database read/write
# scopes, and delete it again once setup has run if you don't expect to
# re-run migrations.
APPWRITE_SETUP_API_KEY=
