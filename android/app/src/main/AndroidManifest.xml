<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Where the system browser hands a finished Google/Apple OAuth
                 login back to this app (see src/lib/auth.ts's
                 startOAuthSignIn and src/app/oauth-callback-listener.tsx) —
                 Google and Apple both refuse to complete that login inside
                 an embedded WebView, so it has to run in the system browser
                 and come back through a deep link instead. The literal
                 project ID here (matching NEXT_PUBLIC_APPWRITE_PROJECT_ID)
                 is Appwrite's own documented `appwrite-callback-{PROJECT_ID}`
                 convention, not a value invented for this app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="appwrite-callback-6a7cd5df0036246ce258" />
            </intent-filter>

            <!-- Invite links (src/app/convite/page.tsx tries this first,
                 before falling back to the web landing page) — handled in
                 src/app/oauth-callback-listener.tsx alongside the OAuth
                 callback above, same appUrlOpen listener. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="xanthus" android:host="convite" />
            </intent-filter>

            <!-- "Corrida em dupla" QR pairing (src/app/parear/page.tsx tries
                 this first, same fallback pattern as convite above) —
                 android:host is matched exactly, so this needs its own
                 intent-filter rather than reusing convite's. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="xanthus" android:host="parear" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- @capgo/capacitor-health (src/lib/health.ts) — required by Health
             Connect so a user who taps the permissions-rationale link from
             its own settings screen lands somewhere; nothing in this app
             links here directly. Package changed from com.fit_up.health.
             capacitor.* to app.capgo.plugin.health.* when the plugin was
             swapped (the previous fork never exposed HRV/sleep/VO2 max —
             see health.ts's own comment). Declaring this is harmless on its
             own: the READ_* permissions below only get requested once
             HEALTH_DATA_ENABLED in health.ts actually flips to true, which
             it doesn't yet. -->
        <activity
            android:name="app.capgo.plugin.health.PermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="app.capgo.plugin.health.PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

    <!-- @capgo/capacitor-health: lets the app detect whether Health Connect
         itself is installed (Health.isAvailable() in health.ts). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Required on Android 13+ (API 33) for any notification to display at
         all — without this, PushNotifications.requestPermissions() in
         src/lib/pushNotifications.ts silently can't be granted and FCM
         delivery to this device never surfaces in the system tray, even
         though everything server-side (provider, milestone trigger) reports
         success. Missing this was the actual cause of "notificação de marco
         não aparece" on Android — nothing else in the send path was broken. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- @capgo/capacitor-health — read-only, matching REQUIRED_READ_TYPES in
         health.ts exactly. Declaring these doesn't grant them: Health
         Connect still shows its own consent screen the first time
         requestHealthPermissions() actually runs, which only happens once
         HEALTH_DATA_ENABLED is true. Four new entries (resting HR, HRV,
         VO2 max, sleep) since the plugin swap — the previous fork couldn't
         read any of the four. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!-- @capgo/capacitor-health's own AndroidManifest.xml (node_modules/
         @capgo/capacitor-health/android/src/main/AndroidManifest.xml)
         declares a much broader set of Health Connect permissions than this
         app actually requests — every WRITE_* one (this app is strictly
         read-only, per health.ts's own comment) plus 15 READ_* ones for data
         this app never reads (blood pressure, blood glucose, body fat,
         height, weight, mindfulness, nutrition, hydration, etc.). Manifest
         merging pulls all of those into the built app regardless, which
         surfaced as a real problem, not just a form-filling one: the Play
         Console's Health Connect permissions declaration (found 2026-08-24)
         requires a written justification for every one of them, including
         ones the app has no legitimate use for and no honest answer to.
         Removed here via `tools:node="remove"` so the shipped app's actual
         permission set matches REQUIRED_READ_TYPES in health.ts exactly —
         the least-privilege posture that module's own comment already
         claims, but the manifest merge was silently not honoring. -->
    <uses-permission android:name="android.permission.health.WRITE_STEPS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_VO2_MAX" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" tools:node="remove" />
    <!-- READ_DISTANCE used to be requested above like the other 8 real
         permissions, but health.ts never actually read a Workout's distance
         field — found the same way as the rest of this block (Play
         Console's justification form has no honest answer for a permission
         nothing consumes), just later, after distance had already shipped
         requested for a while. -->
    <uses-permission android:name="android.permission.health.READ_DISTANCE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_NUTRITION" tools:node="remove" />
</manifest>
