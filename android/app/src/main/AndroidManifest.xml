<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Where the system browser hands a finished Google/Apple OAuth
                 login back to this app (see src/lib/auth.ts's
                 startOAuthSignIn and src/app/oauth-callback-listener.tsx) —
                 Google and Apple both refuse to complete that login inside
                 an embedded WebView, so it has to run in the system browser
                 and come back through a deep link instead. The literal
                 project ID here (matching NEXT_PUBLIC_APPWRITE_PROJECT_ID)
                 is Appwrite's own documented `appwrite-callback-{PROJECT_ID}`
                 convention, not a value invented for this app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="appwrite-callback-6a7cd5df0036246ce258" />
            </intent-filter>

            <!-- Invite links (src/app/convite/page.tsx tries this first,
                 before falling back to the web landing page) — handled in
                 src/app/oauth-callback-listener.tsx alongside the OAuth
                 callback above, same appUrlOpen listener. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="xanthus" android:host="convite" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- capacitor-health (src/lib/health.ts) — required by Health Connect
             so a user who taps the permissions-rationale link from its own
             settings screen lands somewhere; nothing in this app links here
             directly. Declaring this is harmless on its own: the READ_*
             permissions below only get requested once HEALTH_DATA_ENABLED
             in health.ts actually flips to true, which it doesn't yet. -->
        <activity
            android:name="com.fit_up.health.capacitor.PermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="com.fit_up.health.capacitor.PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

    <!-- capacitor-health: lets the app detect whether Health Connect itself
         is installed (Health.isHealthAvailable() in health.ts). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- capacitor-health — read-only, matching REQUIRED_PERMISSIONS in
         health.ts exactly. Declaring these doesn't grant them: Health
         Connect still shows its own consent screen the first time
         requestHealthPermissions() actually runs, which only happens once
         HEALTH_DATA_ENABLED is true. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
</manifest>
