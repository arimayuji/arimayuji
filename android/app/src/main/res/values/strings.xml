<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="app_name">Xanthus</string>
    <string name="title_activity_main">Xanthus</string>
    <string name="package_name">com.xanthus.app</string>
    <string name="custom_url_scheme">com.xanthus.app</string>

    <!--
      Read by BackgroundGeolocationService#newNotificationBuilder() via
      getAppString(). Paired with setColorized(true) there, this makes the
      tracking notification's *entire* background our own dark brand color
      (matches the "background" token in globals.css' dark theme / the
      background_color entry in manifest.ts) instead of whatever translucent
      scrim the OS/OEM lock screen renders behind ?android:attr/textColor* —
      see notification_run.xml for why that mattered: those attrs read fine
      against a solid Material notification-drawer background, but nearly
      vanished against some lock screens' wallpaper-bleeding scrim. Owning
      the background outright removes that dependency entirely.
    -->
    <string name="capacitor_background_geolocation_notification_color" translatable="false">#0B0E11</string>

    <!--
      Read by BackgroundGeolocationService#createRichBackgroundNotification()
      via getAppString(), same mechanism as the background color above. Tints
      the route thumbnail's line and "current position" dot — matches the
      "accent" token in globals.css' dark theme, the same blue every other
      route/map/chart in the app already draws with (see LIVE_MARKER in
      route-map.tsx). Before this, the thumbnail drew in a plain theme
      foreground color, which is why the notification read as generic
      Android chrome instead of something recognizably Xanthus.
    -->
    <string name="capacitor_background_geolocation_notification_accent_color" translatable="false">#5B8DFF</string>
</resources>
