<?xml version="1.0" encoding="utf-8"?>
<!--
  Xanthus fork — not part of the upstream plugin.

  Replaces android.R.drawable.ic_menu_close_clear_cancel (a generic "X"
  glyph, which also sends the wrong meaning — finishing a run saves it, it
  isn't cancelling anything) as the "Finalizar" notification action icon.
  A rounded square is the universal "stop" glyph, matching what the on-screen
  HoldToFinishButton on /run represents. Solid white fill: see
  ic_notif_pause.xml for why — the system re-tints action icons for contrast.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path android:fillColor="#FFFFFF" android:pathData="M6,6h12v12h-12z" />
</vector>
