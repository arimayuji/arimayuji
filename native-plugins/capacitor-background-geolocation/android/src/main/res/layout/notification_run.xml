<?xml version="1.0" encoding="utf-8"?>
<!--
  Xanthus fork — not part of the upstream plugin.

  Custom content view for the persistent tracking notification's "rich"
  mode (distância/ritmo/tempo + route thumbnail), set via
  Notification.Builder#setCustomContentView + DecoratedCustomViewStyle so
  the system still draws its own chrome (app icon, app name, timestamp)
  around this. Text colors use the theme attrs (?android:attr/...) rather
  than hardcoded colors so this reads correctly on both a light and a dark
  notification shade — the shade's own theme, not the app's.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISTÂNCIA"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/xanthus_stat_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RITMO"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/xanthus_stat_pace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>

    <ImageView
        android:id="@+id/xanthus_route_thumb"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@null"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TEMPO"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/xanthus_stat_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>
</LinearLayout>
