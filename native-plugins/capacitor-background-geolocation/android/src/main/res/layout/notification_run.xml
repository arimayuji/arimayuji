<?xml version="1.0" encoding="utf-8"?>
<!--
  Xanthus fork — not part of the upstream plugin.

  Custom content view for the persistent tracking notification's "rich"
  mode (distância/ritmo/tempo + route thumbnail), set via
  Notification.Builder#setCustomContentView + DecoratedCustomViewStyle so
  the system still draws its own chrome (app icon, app name, timestamp)
  around this.

  Text colors are our own fixed dark-theme tokens (#EEF1F3 foreground,
  #8B949C muted — matching the "foreground"/"muted" tokens in globals.css'
  dark theme), not ?android:attr/textColor* theme attrs. Those attrs read fine
  against a solid Material notification-drawer background, but on a lock
  screen whose OS/OEM renders a translucent scrim with wallpaper bleeding
  through, textColorSecondary's built-in ~54% alpha nearly vanished, and
  even textColorPrimary only reads correctly by coincidence — depending on
  system theme for contrast means an arbitrary wallpaper decides whether
  this is legible, and never carries the app's own colors either way.
  BackgroundGeolocationService#newNotificationBuilder() now pins the
  notification's actual background to our own dark brand color via
  setColor() + setColorized(true) (see capacitor_background_geolocation_
  notification_color in the app's strings.xml), so these fixed colors are
  guaranteed to land on the background they were actually designed for.

  The thin vertical rules between stat columns and the route thumbnail's
  own card background (bg_route_thumb_chip) borrow the same hairline-border
  and surface-panel language every Card in the web/app UI already uses
  (globals.css' "border"/"surface" tokens) — this view used to be three
  bare text columns and a stray icon with none of that, which read as
  generic Android chrome rather than something recognizably Xanthus.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISTÂNCIA"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:textColor="#8B949C" />

        <TextView
            android:id="@+id/xanthus_stat_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#EEF1F3" />
    </LinearLayout>

    <!-- FrameLayout, not a bare View: RemoteViews' inflater only accepts a
         fixed allow-list of classes, and plain android.view.View isn't
         reliably on it across OS versions — using it here crashed the whole
         app with a RemoteServiceException$BadForegroundServiceNotificationException
         ("Error inflating class android.view.View") the moment this
         notification was first shown, ~5s into every run. FrameLayout is a
         ViewGroup and always accepted; an empty one with just a background
         renders identically as a solid divider line. -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="26dp"
        android:layout_marginHorizontal="10dp"
        android:background="#262C33" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RITMO"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:textColor="#8B949C" />

        <TextView
            android:id="@+id/xanthus_stat_pace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#EEF1F3" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="26dp"
        android:layout_marginHorizontal="10dp"
        android:background="#262C33" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TEMPO"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:textColor="#8B949C" />

        <TextView
            android:id="@+id/xanthus_stat_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#EEF1F3" />
    </LinearLayout>

    <ImageView
        android:id="@+id/xanthus_route_thumb"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:padding="5dp"
        android:background="@drawable/bg_route_thumb_chip"
        android:contentDescription="@null"
        android:visibility="gone" />
</LinearLayout>
